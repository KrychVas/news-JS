# Copy this file to `.env` and adjust the values for your environment.

# Base url of the News API.
# News API v2 rejects requests from any origin except localhost, so the
# CORS proxy below is used for both the local and the deployed build:
# https://rss-news-api.onrender.com/ -> /sources, /everything
# Original endpoint: https://newsapi.org/v2/
#
# To keep the key out of the public bundle, deploy the worker from `worker/`
# and use its url instead:
# API_URL=https://news-api-proxy.<your-subdomain>.workers.dev/
API_URL=https://rss-news-api.onrender.com/

# Personal key from https://newsapi.org/ .
# Leave empty when the proxy above is used - it already holds its own key.
API_KEY=

# `true`  -> /mocks/sources and /mocks/everything of the proxy are used.
#            Static data, no key required, request limit is never exhausted.
# `false` -> live proxied News API. Requires a personal API_KEY, otherwise the
#            proxy answers `401 Unauthorized`.
API_USE_MOCKS=true
